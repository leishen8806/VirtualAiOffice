{
  "name": "niuma-studio",
  "version": "0.3.0",
  "description": "牛马工作室：你只跟总管傻妞说话，她按难度和技能把任务派给各个项目组（Claude Code、Codex、DeepSeek、中转站 API…）的员工，自动验收、返工、存档。",
  "type": "module",
  "bin": {
    "niuma": "bin/niuma.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node bin/niuma.js",
    "rehearsal": "node bin/niuma.js --fake",
    "test": "node --test",
    "build:packages": "tsc -b",
    "test:packages": "tsc -b && node --test packages/*/dist-spec/*.spec.js",
    "verify:packaged-layout": "node scripts/verify-packaged-layout.mjs",
    "test:all": "npm test && npm run test:packages && npm run verify:packaged-layout"
  },
  "files": [
    "bin",
    "src",
    "public",
    "fake",
    "skills",
    "packages/executors/runtime",
    "niuma.config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "~26.2.0",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leishen8806/VirtualAiOffice.git"
  },
  "homepage": "https://github.com/leishen8806/VirtualAiOffice",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "deepseek",
    "multi-agent",
    "coding-agent",
    "pixel-art"
  ]
}
